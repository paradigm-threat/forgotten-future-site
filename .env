NEXT_PUBLIC_API_BASE=https://forgottenfuturebook.com
NEXT_PUBLIC_REPO_STORY=http://localhost:3000/story/
NEXT_PUBLIC_REPO_TEASER=https://api.github.com/repos/clevertree/ff-teaser
NEXT_PUBLIC_REPO_SITE=https://api.github.com/repos/clevertree/forgotten-future-site
