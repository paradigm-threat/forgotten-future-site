# Auth / OAuth (optional)
# GITHUB_ID=
# GITHUB_SECRET=
# GITHUB_APP_TOKEN=

# NextAuth configuration
NEXTAUTH_URL=https://forgottenfuturebook.com
# NEXTAUTH_SECRET=

# Feature Flags
NEXT_PUBLIC_IS_STATIC=false

# Remote story/teaser mirrors (Relay fleet; GitLab Pages is always appended as fallback)
NEXT_PUBLIC_STORY_RAW_BASE=https://ff-story.ord1.relaygateway.net
NEXT_PUBLIC_TEASER_RAW_BASE=https://ff-teaser.ord1.relaygateway.net

# Piper TTS — browser calls relay-gateway directly (see .env.local for secret)
NEXT_PUBLIC_PIPER_API_URLS=https://ord1.relaygateway.net https://hkg1.relaygateway.net
# PIPER_API_SECRET / NEXT_PUBLIC_PIPER_API_SECRET in .env.local
