# GITHUB_SECRET=
# GITHUB_APP_TOKEN=

# NextAuth configuration
NEXTAUTH_URL=https://forgottenfuturebook.com
# NEXTAUTH_SECRET=

# Feature Flags
NEXT_PUBLIC_ALLOW_ANONYMOUS_COMMENTS=true
NEXT_PUBLIC_IS_STATIC=false

# Repository URLs (GitLab)
