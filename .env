NEXT_PUBLIC_API_BASE=https://forgottenfuturebook.com
NEXT_PUBLIC_REPO_STORY=https://gitlab.com/api/v4/projects/clevertree%2Fff-story
NEXT_PUBLIC_REPO_TEASER=https://gitlab.com/api/v4/projects/clevertree%2Fff-teaser
NEXT_PUBLIC_REPO_SITE=https://gitlab.com/api/v4/projects/clevertree%2Fforgotten-future-site
# GitLab Pages (published origins; see lib/ffPagesUrls.ts defaults)
NEXT_PUBLIC_STORY_RAW_BASE=https://ff-story-6a84a5.gitlab.io
NEXT_PUBLIC_TEASER_RAW_BASE=https://ff-teaser-12140e.gitlab.io

# Piper TTS (remote clevertree-tts-server)
PIPER_API_URL=http://173.230.140.32
# PIPER_API_SECRET is set in .env.local (not committed) and Vercel env vars
