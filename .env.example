# Static production build (GitLab Pages / zero serverless)
NEXT_PUBLIC_IS_STATIC=true
NEXT_PUBLIC_BASE_PATH=/forgotten-future-site
NEXT_PUBLIC_SITE_URL=https://clevertree.gitlab.io/forgotten-future-site

# ff-story mirror(s) — whitespace-separated; GitLab Pages is always appended as fallback
NEXT_PUBLIC_STORY_RAW_BASE=https://ff-story.ord1.relaygateway.net
# NEXT_PUBLIC_STORY_BASE_URL=  # alias

# ff-teaser mirror(s)
NEXT_PUBLIC_TEASER_RAW_BASE=https://ff-teaser.ord1.relaygateway.net

# Piper TTS — browser calls relay-gateway directly (no /api/tts)
NEXT_PUBLIC_PIPER_API_URLS=https://ord1.relaygateway.net https://hkg1.relaygateway.net
# NEXT_PUBLIC_PIPER_API_SECRET=

# GitLab Pages fallbacks (when Relay env unset):
# https://ff-story-6a84a5.gitlab.io
# https://ff-teaser-12140e.gitlab.io
